# Gateway API base URL
VITE_API_URL=http://localhost:8000
# Development API key. Never commit a real key.
VITE_API_KEY=dev-coordinator-key

# Optional: shows each incident's real coordinates on an embedded map.
# Google Cloud Console -> enable "Maps Embed API" -> create a key.
# Without this, the dashboard still shows the raw lat/long, just no map tile.
VITE_GOOGLE_MAPS_API_KEY=
