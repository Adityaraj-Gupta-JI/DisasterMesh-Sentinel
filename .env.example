# Copy to .env and fill in. Never commit .env.
# Every value below is a placeholder. No real credential belongs in this file.

# --- Backend ---
DMS_ENV=development
DMS_DATABASE_URL=sqlite+aiosqlite:///./runtime/disastermesh.db
DMS_API_HOST=127.0.0.1
DMS_API_PORT=8000
DMS_CORS_ORIGINS=http://localhost:5173
DMS_JWT_SECRET=replace-me-locally-generated-value
DMS_MAX_UPLOAD_BYTES=10485760
DMS_ALLOWED_UPLOAD_MIME=image/jpeg,image/png,audio/ogg,audio/mp4,application/pdf

# --- AI service ---
DMS_AI_BASE_URL=http://127.0.0.1:8001
DMS_AI_MODE=mock          # mock | real  — real requires model downloads (approval gate)
DMS_AI_TIMEOUT_SECONDS=5
DMS_AI_MAX_INPUT_CHARS=4000
DMS_MODEL_CACHE_DIR=./runtime/models

# --- Dashboard ---
VITE_API_BASE_URL=http://127.0.0.1:8000

# --- Android (set in local.properties or CI, not here) ---
# ANDROID_HOME=/home/<user>/Android/Sdk
