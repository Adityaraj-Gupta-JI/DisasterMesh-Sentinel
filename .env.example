# DisasterMesh Sentinel — environment template.
# Copy to .env and fill in. .env is git-ignored; never commit real values.

# ---------------------------------------------------------------- gateway API
DMS_ENV=development
DMS_DATABASE_URL=sqlite:///./dms_gateway.db
DMS_CORS_ORIGINS=http://localhost:5173
DMS_MAX_UPLOAD_BYTES=8388608

# API keys as key:user:ROLE:org, comma separated.
# Leave empty in development to use the built-in dev keys.
# In production (DMS_ENV=production) an empty value authorizes NOBODY, by design.
# DMS_API_KEYS=replace-me:user_coordinator:EVENT_COORDINATOR:org_demo

# ----------------------------------------------------------------- AI service
# "mock" (default) = deterministic rule-based triage, fully offline, no data
# leaves this machine. "llm" = call a cloud LLM for triage instead, falling
# back to the rule engine automatically on any failure/timeout — this sends
# incident text (which can include medical/location detail) to a third party,
# so it is off by default and only takes effect once DMS_AI_LLM_API_KEY is set.
DMS_AI_MODE=mock
DMS_AI_TIMEOUT_S=10
DMS_AI_LOG_PAYLOADS=false

# Only used when DMS_AI_MODE=llm. Any OpenAI-compatible chat-completions
# endpoint works (Groq's free tier is the default below); no provider SDK is
# required, just the existing httpx dependency.
DMS_AI_LLM_PROVIDER_URL=https://api.groq.com/openai/v1/chat/completions
DMS_AI_LLM_API_KEY=
DMS_AI_LLM_MODEL=llama-3.1-8b-instant

# Real models load only when explicitly enabled. Each pulls large weights.
DMS_AI_ENABLE_WHISPER=false
DMS_AI_ENABLE_TRIAGE=false
DMS_AI_ENABLE_ENTITIES=false
DMS_AI_ENABLE_EMBEDDINGS=false
DMS_AI_ENABLE_TRANSLATION=false

DMS_AI_WHISPER_CKPT=openai/whisper-small
DMS_AI_TRIAGE_CKPT=xlm-roberta-base
DMS_AI_ENTITY_CKPT=microsoft/mdeberta-v3-base
DMS_AI_EMBED_CKPT=intfloat/multilingual-e5-large
DMS_AI_TRANSLATE_CKPT=facebook/nllb-200-distilled-600M

# ------------------------------------------------------------------ dashboard
VITE_API_URL=http://localhost:8000
VITE_API_KEY=dev-coordinator-key
